{
  "name": "Banking",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-CA",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Transactions",
        "columns": [
          {
            "name": "transaction_id",
            "dataType": "string",
            "sourceColumn": "transaction_id",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "account_id",
            "dataType": "string",
            "sourceColumn": "account_id",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "product_id",
            "dataType": "string",
            "sourceColumn": "product_id",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "transaction_date",
            "dataType": "dateTime",
            "sourceColumn": "transaction_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "transaction_type",
            "dataType": "string",
            "sourceColumn": "transaction_type",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "direction",
            "dataType": "string",
            "sourceColumn": "direction",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "channel_id",
            "dataType": "string",
            "sourceColumn": "channel_id",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "transaction_amount",
            "dataType": "double",
            "sourceColumn": "transaction_amount",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "bank_revenue",
            "dataType": "double",
            "sourceColumn": "bank_revenue",
            "summarizeBy": "none",
            "formatString": ""
          },
          {
            "name": "is_digital",
            "dataType": "int64",
            "sourceColumn": "is_digital",
            "summarizeBy": "none",
            "formatString": ""
          }
        ],
        "partitions": [
          {
            "name": "Transactions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Embedded = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Csv = Csv.Document(Embedded, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"transaction_id\", type text}, {\"account_id\", type text}, {\"customer_id\", type text}, {\"product_id\", type text}, {\"transaction_date\", type date}, {\"transaction_type\", type text}, {\"direction\", type text}, {\"channel_id\", type text}, {\"transaction_amount\", type number}, {\"bank_revenue\", type number}, {\"is_digital\", Int64.Type}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Bank Revenue",
            "expression": "SUM(Transactions[bank_revenue])",
            "formatString": "$#,0",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Transactions",
            "expression": "COUNTROWS(Transactions)",
            "formatString": "#,0",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Total Customers",
            "expression": "COUNTROWS(Customers)",
            "formatString": "#,0",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Active Customers As Of Aug 31",
            "expression": "CALCULATE(COUNTROWS(Customers), Customers[customer_status] = \"Active\")",
            "formatString": "#,0",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Inactive Rate As Of Aug 31",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Customers), Customers[customer_status] = \"Inactive\"), [Total Customers])",
            "formatString": "0.0%",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Digital Transaction Share",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Transactions), Transactions[is_digital] = 1), [Transactions])",
            "formatString": "0.0%",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Bank Revenue Per Portfolio Customer",
            "expression": "DIVIDE([Total Bank Revenue], [Total Customers])",
            "formatString": "$#,0.00",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Transacting Customers",
            "expression": "DISTINCTCOUNT(Transactions[customer_id])",
            "formatString": "#,0",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Bank Revenue Per Transacting Customer",
            "expression": "DIVIDE([Total Bank Revenue], [Transacting Customers])",
            "formatString": "$#,0.00",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Products Per Customer",
            "expression": "DIVIDE(COUNTROWS(Accounts), [Total Customers])",
            "formatString": "0.00",
            "displayFolder": "Portfolio KPIs"
          },
          {
            "name": "Revenue Share Within Selection",
            "expression": "DIVIDE([Total Bank Revenue], CALCULATE([Total Bank Revenue], ALLSELECTED(Products[product_name])))",
            "formatString": "0.0%",
            "displayFolder": "Portfolio KPIs"
          }
        ]
      },
