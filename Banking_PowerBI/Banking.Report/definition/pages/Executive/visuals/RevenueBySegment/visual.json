              },
              "queryRef": "Customers.segment",
              "nativeQueryRef": "segment"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Total Bank Revenue"
                }
              },
              "queryRef": "Transactions.Total Bank Revenue",
              "nativeQueryRef": "Total Bank Revenue"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}