{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "RevenueTrend",
  "position": {
    "x": 25,
    "y": 255,
    "z": 0,
    "height": 400,
    "width": 730,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "year_month"
                }
              },
              "queryRef": "Calendar.year_month",
              "nativeQueryRef": "year_month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Total Bank Revenue"
                }
              },
              "queryRef": "Transactions.Total Bank Revenue",
              "nativeQueryRef": "Total Bank Revenue"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}